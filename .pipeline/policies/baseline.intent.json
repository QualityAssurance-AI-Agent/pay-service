{
  "rules": [
    {
      "rule_type": "require_gate_before",
      "job_class": "code-review",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "security-scan",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "unit-test",
      "before": "deploy",
      "paths": [
        "src/**",
        "services/**",
        "lib/**",
        "libs/**"
      ]
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "load-test",
      "before": "production",
      "paths": [
        "services/**"
      ]
    },
    {
      "rule_type": "require_environment_before",
      "environment": "gamma",
      "before_environment": "prod"
    },
    {
      "rule_type": "require_approval",
      "stage_selector": "production"
    }
  ],
  "summary": "Gate code review and security scan before every deploy; unit tests before deploy for code/service/library changes; load test before prod for services changes; gamma before prod; production deploys need approval."
}
