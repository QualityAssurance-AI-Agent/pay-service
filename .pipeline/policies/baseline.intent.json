{
  "rules": [
    {
      "rule_type": "require_gate_before",
      "job_class": "code-review",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "security-scan",
      "before": "deploy"
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "unit-test",
      "before": "deploy",
      "paths": [
        "src/**",
        "services/**",
        "lib/**",
        "libs/**"
      ]
    },
    {
      "rule_type": "require_gate_before",
      "job_class": "load-test",
      "before_environment": "prod",
      "paths": [
        "services/**"
      ]
    },
    {
      "rule_type": "require_environment_before",
      "environment": "gamma",
      "before_environment": "prod"
    },
    {
      "rule_type": "require_approval",
      "stage_selector": "production"
    }
  ],
  "summary": "Gate every deployment on code-review and security-scan; unit-test source/service/library changes before deploy; load-test services/ changes before prod; gamma before prod; production needs approval."
}
